# Copie para .env (local) e configure as mesmas variáveis no Render.
# NUNCA envie o arquivo .env para o GitHub.

# Servidor
PORT=3000
NODE_ENV=development
# Domínios do frontend permitidos no CORS, separados por vírgula.
# Se vazio, usa https://sowestudio.com.br (e localhost fora de produção).
CORS_ORIGINS=http://localhost:5173
# Quantos proxies existem na frente da API (padrão 1, o do Render). Confira nos
# logs do Render se `ip=` mostra o IP real do cliente; se não, ajuste.
# TRUST_PROXY_HOPS=1

# Banco de dados (Neon)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Autenticação
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1d

# Zoho Calendar
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_CALENDAR_ID=
ZOHO_TNK_STORE_CALENDAR_ID=
ZOHO_PERSONAL_NOTIFICATION_EMAIL=
# Só altere se a sua conta Zoho NÃO for da região .com (ex.: .eu, .in)
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_CALENDAR_API_URL=https://calendar.zoho.com/api/v1

# Monday
MONDAY_TOKEN=

# Métricas do YouTube (chave da YouTube Data API v3, do Google Cloud)
YOUTUBE_API_KEY=
# Opcional: IDs dos canais separados por vírgula (padrão: os 3 canais do estúdio)
# YOUTUBE_CHANNEL_IDS=
